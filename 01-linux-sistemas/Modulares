    const x = list[i]; tries = 0;
    document.getElementById('cnt').textContent = (i+1) + ' / ' + list.length;
    document.getElementById('pr').textContent = PROMPTS[x.m] || PROMPTS.docker;
    ln('');
    ln('[' + x.t + ' · ' + ({docker:'docker',dockerfile:'Dockerfile',k8s:'Kubernetes'})[x.m] + '] ' + x.p, 'task');
    cin.focus();
  }
  function hint(){ const x = list[i]; if (!x) return; const s = x.s; const first = s.split(/\s+/)[0]; ln('Pista: empieza por «' + first + '» y tiene ' + s.split(/\s+/).length + ' palabras.', 'dim'); }
  function solution(){ const x = list[i]; if (!x) return; ln('Solución: ' + x.s, 'sol'); }
  function next(){ i++; task(); }
  cin.addEventListener('keydown', e => {
    if (e.key === 'ArrowUp'){ if (hist.length){ hpos = Math.max(0, hpos - 1); cin.value = hist[hpos]; } e.preventDefault(); return; }
    if (e.key === 'ArrowDown'){ if (hist.length){ hpos = Math.min(hist.length, hpos + 1); cin.value = hist[hpos] || ''; } e.preventDefault(); return; }
    if (e.key !== 'Enter') return;
    const v = cin.value; cin.value = ''; if (!v.trim()) return;
    hist.push(v); hpos = hist.length;
    const x = list[i]; ln((PROMPTS[x ? x.m : 'docker'] || PROMPTS.docker) + v);
    const c = norm(v);
    if (c === 'pista' || c === 'hint'){ hint(); return; }
    if (c === 'solucion' || c === 'solución'){ solution(); return; }
    if (c === 'saltar' || c === 'siguiente'){ solution(); next(); return; }
    if (c === 'cls' || c === 'clear' || c === 'clear-host'){ out.innerHTML = ''; task(); return; }
    if (!x) return;
    if (checkEx(x, v)){
      okCount++; const k = EX.indexOf(x); S.ex[k] = (S.ex[k]||0) + 1; save();
      ln('✔ Correcto' + (norm(x.s) !== c ? '  (forma de referencia: ' + x.s + ')' : ''), 'okc'); setTimeout(next, 450);
    } else {
      tries++;
      ln('✘ No es correcto. ' + (tries === 1 ? 'Revisa el nombre del comando y los parámetros.' : tries === 2 ? 'Escribe «pista» si lo necesitas.' : 'Escribe «solucion» para verla.'), 'koc');
    }
  });
  document.getElementById('hint').onclick = () => { hint(); cin.focus(); };
  document.getElementById('sol').onclick = () => { solution(); cin.focus(); };
  document.getElementById('skip').onclick = () => { solution(); next(); };
  document.getElementById('back').onclick = () => topicId ? openTopic(topicId) : setTab('consola');
  term.onclick = () => cin.focus();
  ln('Consola de práctica TAI. Comandos especiales: pista, solucion, saltar, cls.', 'dim');
  task();
}

/* ---------- review ---------- */
function renderReview(){
  const fails = QS.filter(q => S.q[q.id] && S.q[q.id].last === 0);
  const stars = QS.filter(q => S.star[q.id]);
  const weak = QS.filter(q => S.q[q.id] && S.q[q.id].ko > S.q[q.id].ok);
  const okList = QS.filter(q => S.q[q.id] && S.q[q.id].last === 1);
  view.innerHTML = '<h2 class="view">Repaso</h2><p class="muted">Aquí se guardan tus aciertos y fallos para que repases lo que más te cuesta.</p>' +
    '<div class="grid">' +
    '<div class="stat"><span class="muted">Falladas la última vez</span><b style="color:var(--ko)">'+fails.length+'</b><button class="btn primary" id="rF" '+(fails.length?'':'disabled')+'>Repasar</button></div>' +
    '<div class="stat"><span class="muted">Puntos débiles (más fallos que aciertos)</span><b>'+weak.length+'</b><button class="btn" id="rW" '+(weak.length?'':'disabled')+'>Repasar</button></div>' +
    '<div class="stat"><span class="muted">Marcadas con ★</span><b style="color:#c48a00">'+stars.length+'</b><button class="btn" id="rS" '+(stars.length?'':'disabled')+'>Repasar</button></div>' +
    '<div class="stat"><span class="muted">Acertadas (para refrescar)</span><b style="color:var(--ok)">'+okList.length+'</b><button class="btn" id="rO" '+(okList.length?'':'disabled')+'>Repasar 20 al azar</button></div>' +
    '</div>' +
    '<h3>Temas con más fallos</h3>' + topicRanking();
  const go = (id, l, t) => { const b = document.getElementById(id); if (b && l.length) b.onclick = () => startQuiz(shuffle(l.slice()), {title:t, practice:true}); };
  go('rF', fails, 'Repaso de fallos'); go('rW', weak, 'Puntos débiles'); go('rS', stars, 'Marcadas ★');
  const o = document.getElementById('rO'); if (o && okList.length) o.onclick = () => startQuiz(shuffle(okList.slice()).slice(0,20), {title:'Refrescar aciertos', practice:true});
  view.querySelectorAll('[data-go]').forEach(b => b.onclick = () => openTopic(b.dataset.go));
}
function topicRanking(){
  const r = topics.map(t => { let ok = 0, ko = 0; (qByTopic[t.id]||[]).forEach(q => { const s = S.q[q.id]; if (s){ ok += s.ok; ko += s.ko; } }); return {t, ok, ko}; })
    .filter(x => x.ko > 0).sort((a,b) => (b.ko/(b.ok+b.ko)) - (a.ko/(a.ok+a.ko)) || b.ko - a.ko).slice(0, 12);
  if (!r.length) return '<div class="card empty">Aún no hay fallos registrados. Haz algún test.</div>';
  return '<div class="card">' + r.map(x => { const p = Math.round(100 * x.ok / (x.ok + x.ko)); return '<div class="row" style="justify-content:space-between;margin:8px 0"><button class="btn ghost" data-go="'+x.t.id+'" style="text-align:left">'+x.t.id+' · '+esc(x.t.title)+'</button><span class="muted">'+p+'% aciertos ('+x.ok+'/'+(x.ok+x.ko)+')</span></div><div class="bar"><i style="width:'+p+'%"></i></div>'; }).join('') + '</div>';
}

/* ---------- progress ---------- */
function renderProgress(){
  const answered = Object.keys(S.q).length; let ok = 0, ko = 0; Object.values(S.q).forEach(s => { ok += s.ok; ko += s.ko; });
  const exDone = Object.keys(S.ex).length;
  const per = Object.keys(COURSES).map(c => {
    const qs = QS.filter(q => q.t.startsWith(c + '-')); const a = qs.filter(q => S.q[q.id]).length;
    let o = 0, k = 0; qs.forEach(q => { const s = S.q[q.id]; if (s){ o += s.ok; k += s.ko; } });
    return '<div class="card"><h3 style="margin-top:0">'+COURSES[c]+'</h3><div class="row" style="justify-content:space-between"><span>Teoría estudiada</span><b>'+coursePct(c)+'%</b></div><div class="bar"><i style="width:'+coursePct(c)+'%"></i></div>' +
      '<div class="row" style="justify-content:space-between;margin-top:10px"><span>Preguntas vistas</span><b>'+a+' / '+qs.length+'</b></div><div class="bar"><i style="width:'+(100*a/qs.length)+'%"></i></div>' +
      '<p class="muted">Porcentaje de aciertos: '+(o+k?Math.round(100*o/(o+k))+'%':'—')+'</p></div>';
  }).join('');
  view.innerHTML = '<h2 class="view">Progreso</h2><div class="grid"><div class="stat"><span class="muted">Preguntas respondidas</span><b>'+answered+' / '+QS.length+'</b></div><div class="stat"><span class="muted">Aciertos totales</span><b style="color:var(--ok)">'+ok+'</b></div><div class="stat"><span class="muted">Fallos totales</span><b style="color:var(--ko)">'+ko+'</b></div><div class="stat"><span class="muted">Ejercicios de consola superados</span><b>'+exDone+' / '+EX.length+'</b></div></div>' + per +
    '<div class="card"><h3 style="margin-top:0">Copia de seguridad del progreso</h3><p class="muted">El progreso vive en este navegador. Exporta un fichero para pasarlo a otro equipo.</p><div class="row"><button class="btn" id="exp">Exportar progreso</button><label class="btn">Importar progreso<input type="file" id="imp" accept="application/json" class="hidden"></label><button class="btn" id="rst" style="color:var(--ko)">Borrar todo el progreso</button></div></div>';
  document.getElementById('exp').onclick = () => { const b = new Blob([JSON.stringify(S)], {type:'application/json'}); const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'progreso-tai-windows-redes.json'; a.click(); };
  document.getElementById('imp').onchange = e => { const f = e.target.files[0]; if (!f) return; f.text().then(t => { try { S = Object.assign({read:{},q:{},star:{},ex:{}}, JSON.parse(t)); save(); toast('Progreso importado'); renderTree(); renderProgress(); } catch(err){ toast('Fichero no válido'); } }); };
  document.getElementById('rst').onclick = () => { if (confirm('¿Seguro que quieres borrar todo el progreso?')) { S = {read:{}, q:{}, star:{}, ex:{}, last:null, theme:S.theme}; save(); renderTree(); renderProgress(); } };
}

/* ================= init ================= */
renderTree();
setTab('teoria');
})();
</script>
