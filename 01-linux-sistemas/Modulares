\.io)?$"]}, {"t": "K8-4.3", "m": "k8s", "p": "Lista las NetworkPolicies de todos los namespaces.", "s": "kubectl get networkpolicies -A", "r": ["^kubectl\\s+get\\s+(networkpolicies|networkpolicy|netpol)\\b", "(?c)(-A\\b|--all-namespaces)"]}, {"t": "K8-4.3", "m": "k8s", "p": "Muestra el detalle de la NetworkPolicy deny-all del namespace dev.", "s": "kubectl describe networkpolicy deny-all -n dev", "r": ["^kubectl\\s+describe\\s+(networkpolicy|networkpolicies|netpol)(\\s+|/)deny-all\\b", "(-n|--namespace)[\\s=]dev\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Crea un ConfigMap app-config con la clave MODO=produccion.", "s": "kubectl create configmap app-config --from-literal=MODO=produccion", "r": ["^kubectl\\s+create\\s+(configmap|cm)\\s+app-config\\b", "--from-literal[\\s=]modo=produccion\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Crea un ConfigMap nginx-conf a partir del fichero nginx.conf.", "s": "kubectl create configmap nginx-conf --from-file=nginx.conf", "r": ["^kubectl\\s+create\\s+(configmap|cm)\\s+nginx-conf\\b", "--from-file[\\s=]nginx\\.conf\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Crea un Secret genérico db-pass con la clave password=s3cr3t.", "s": "kubectl create secret generic db-pass --from-literal=password=s3cr3t", "r": ["^kubectl\\s+create\\s+secret\\s+generic\\s+db-pass\\b", "--from-literal[\\s=]password=s3cr3t\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Crea un Secret TLS web-tls con el certificado tls.crt y la clave tls.key.", "s": "kubectl create secret tls web-tls --cert=tls.crt --key=tls.key", "r": ["^kubectl\\s+create\\s+secret\\s+tls\\s+web-tls\\b", "--cert[\\s=]tls\\.crt\\b", "--key[\\s=]tls\\.key\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Crea un Secret regcred de tipo docker-registry para el servidor registro.age.local con usuario teresa y contraseña clave.", "s": "kubectl create secret docker-registry regcred --docker-server=registro.age.local --docker-username=teresa --docker-password=clave", "r": ["^kubectl\\s+create\\s+secret\\s+docker-registry\\s+regcred\\b", "--docker-server[\\s=]registro\\.age\\.local\\b", "--docker-username[\\s=]teresa\\b", "--docker-password[\\s=]clave\\b"]}, {"t": "K8-5.1", "m": "k8s", "p": "Lista los Secrets del namespace actual.", "s": "kubectl get secrets", "r": ["^kubectl\\s+get\\s+(secrets|secret)$"]}, {"t": "K8-5.1", "m": "k8s", "p": "Decodifica el valor password del Secret db-pass (extráelo con jsonpath y pásalo por base64 -d).", "s": "kubectl get secret db-pass -o jsonpath='{.data.password}' | base64 -d", "r": ["^kubectl\\s+get\\s+secrets?(\\s+|/)db-pass\\b", "jsonpath", "\\.data\\.password", "\\|\\s*base64\\s+(-d|--decode)$"]}, {"t": "K8-5.1", "m": "k8s", "p": "Inyecta en el deployment web todas las claves del ConfigMap app-config como variables de entorno.", "s": "kubectl set env deployment/web --from=configmap/app-config", "r": ["^kubectl\\s+set\\s+env\\b", "(deployment|deploy)(\\s+|/)web\\b", "--from[\\s=](configmap|cm)/app-config$"]}, {"t": "K8-5.2", "m": "k8s", "p": "Lista los PersistentVolumes del clúster.", "s": "kubectl get pv", "r": ["^kubectl\\s+get\\s+(pv|persistentvolumes|persistentvolume)$"]}, {"t": "K8-5.2", "m": "k8s", "p": "Lista los PersistentVolumeClaims del namespace actual.", "s": "kubectl get pvc", "r": ["^kubectl\\s+get\\s+(pvc|persistentvolumeclaims|persistentvolumeclaim)$"]}, {"t": "K8-5.2", "m": "k8s", "p": "Lista las StorageClass del clúster (verás cuál es la predeterminada).", "s": "kubectl get storageclass", "r": ["^kubectl\\s+get\\s+(storageclass|storageclasses|sc)$"]}, {"t": "K8-5.2", "m": "k8s", "p": "Muestra el detalle del PVC datos (para ver por qué sigue en Pending).", "s": "kubectl describe pvc datos", "r": ["^kubectl\\s+describe\\s+(pvc|persistentvolumeclaims?)(\\s+|/)datos$"]}, {"t": "K8-5.3", "m": "k8s", "p": "Muestra el consumo de CPU y memoria de los nodos (requiere metrics-server).", "s": "kubectl top nodes", "r": ["^kubectl\\s+top\\s+(nodes|node|no)$"]}, {"t": "K8-5.3", "m": "k8s", "p": "Muestra el consumo de CPU y memoria de los pods del namespace actual.", "s": "kubectl top pods", "r": ["^kubectl\\s+top\\s+(pods|pod|po)$"]}, {"t": "K8-5.3", "m": "k8s", "p": "Crea un autoescalado HPA para el deployment web entre 2 y 10 réplicas al 70 % de CPU.", "s": "kubectl autoscale deployment web --min=2 --max=10 --cpu-percent=70", "r": ["^kubectl\\s+autoscale\\b", "(deployment|deploy)(\\s+|/)web\\b", "--min[\\s=]2\\b", "--max[\\s=]10\\b", "--cpu-percent[\\s=]70\\b"]}, {"t": "K8-5.3", "m": "k8s", "p": "Lista los HorizontalPodAutoscalers del namespace actual.", "s": "kubectl get hpa", "r": ["^kubectl\\s+get\\s+(hpa|horizontalpodautoscalers|horizontalpodautoscaler)$"]}, {"t": "K8-5.3", "m": "k8s", "p": "Fija en el deployment web requests de cpu=250m,memory=256Mi y limits de memory=512Mi.", "s": "kubectl set resources deployment web --requests=cpu=250m,memory=256Mi --limits=memory=512Mi", "r": ["^kubectl\\s+set\\s+resources\\b", "(deployment|deploy)(\\s+|/)web\\b", "--requests[\\s=](cpu=250m,memory=256mi|memory=256mi,cpu=250m)\\b", "--limits[\\s=]memory=512mi\\b"]}, {"t": "K8-5.3", "m": "k8s", "p": "Lista los ResourceQuota del namespace dev.", "s": "kubectl get resourcequota -n dev", "r": ["^kubectl\\s+get\\s+(resourcequota|resourcequotas|quota)\\b", "(-n|--namespace)[\\s=]dev\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Crea una ServiceAccount llamada despliegues.", "s": "kubectl create serviceaccount despliegues", "r": ["^kubectl\\s+create\\s+(serviceaccount|sa)\\s+despliegues$"]}, {"t": "K8-6.1", "m": "k8s", "p": "Crea un Role lector en el namespace actual que permita get, list y watch sobre pods.", "s": "kubectl create role lector --verb=get,list,watch --resource=pods", "r": ["^kubectl\\s+create\\s+role\\s+lector\\b", "--verb[\\s=]get,list,watch\\b", "--resource[\\s=](pods|pod|po)\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Asigna el Role lector al usuario teresa con un RoleBinding llamado lector-teresa.", "s": "kubectl create rolebinding lector-teresa --role=lector --user=teresa", "r": ["^kubectl\\s+create\\s+rolebinding\\s+lector-teresa\\b", "--role[\\s=]lector\\b", "--user[\\s=]teresa\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Da a la ServiceAccount despliegues (namespace dev) el ClusterRole view en todo el clúster con un ClusterRoleBinding llamado ver-todo.", "s": "kubectl create clusterrolebinding ver-todo --clusterrole=view --serviceaccount=dev:despliegues", "r": ["^kubectl\\s+create\\s+clusterrolebinding\\s+ver-todo\\b", "--clusterrole[\\s=]view\\b", "--serviceaccount[\\s=]dev:despliegues\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Comprueba si tú puedes crear deployments en el namespace actual.", "s": "kubectl auth can-i create deployments", "r": ["^kubectl\\s+auth\\s+can-i\\s+create\\s+(deployments|deployment|deploy)\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Comprueba si la ServiceAccount despliegues del namespace dev puede listar pods.", "s": "kubectl auth can-i list pods --as=system:serviceaccount:dev:despliegues", "r": ["^kubectl\\s+auth\\s+can-i\\s+list\\s+(pods|pod|po)\\b", "--as[\\s=]system:serviceaccount:dev:despliegues\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Aplica el nivel restricted de Pod Security (modo enforce) al namespace dev con una etiqueta.", "s": "kubectl label namespace dev pod-security.kubernetes.io/enforce=restricted", "r": ["^kubectl\\s+label\\s+(namespace|ns)(\\s+|/)dev\\b", "pod-security\\.kubernetes\\.io/enforce=restricted\\b"]}, {"t": "K8-6.1", "m": "k8s", "p": "Genera un token temporal para la ServiceAccount despliegues.", "s": "kubectl create token despliegues", "r": ["^kubectl\\s+create\\s+token\\s+despliegues\\b"]}, {"t": "K8-6.2", "m": "k8s", "p": "Marca el nodo nodo2 como no planificable (cordon).", "s": "kubectl cordon nodo2", "r": ["^kubectl\\s+cordon\\s+nodo2$"]}, {"t": "K8-6.2", "m": "k8s", "p": "Vacía el nodo nodo2 para mantenimiento, ignorando los pods de DaemonSets y borrando datos emptyDir.", "s": "kubectl drain nodo2 --ignore-daemonsets --delete-emptydir-data", "r": ["^kubectl\\s+drain\\s+nodo2\\b", "--ignore-daemonsets\\b", "--delete-emptydir-data\\b"]}, {"t": "K8-6.2", "m": "k8s", "p": "Vuelve a permitir que se planifiquen pods en nodo2.", "s": "kubectl uncordon nodo2", "r": ["^kubectl\\s+uncordon\\s+nodo2$"]}, {"t": "K8-6.2", "m": "k8s", "p": "Añade al nodo nodo3 el taint gpu=true con efecto NoSchedule.", "s": "kubectl taint nodes nodo3 gpu=true:NoSchedule", "r": ["^kubectl\\s+taint\\s+(nodes?|no)(\\s+|/)nodo3\\s+gpu=true:noschedule$"]}, {"t": "K8-6.2", "m": "k8s", "p": "Quita del nodo nodo3 el taint gpu con efecto NoSchedule.", "s": "kubectl taint nodes nodo3 gpu=true:NoSchedule-", "r": ["^kubectl\\s+taint\\s+(nodes?|no)(\\s+|/)nodo3\\s+gpu(=true)?:noschedule-$"]}, {"t": "K8-6.2", "m": "k8s", "p": "Pon la etiqueta disco=ssd al nodo nodo1 (para usarla luego en nodeSelector).", "s": "kubectl label nodes nodo1 disco=ssd", "r": ["^kubectl\\s+label\\s+(nodes?|no)(\\s+|/)nodo1\\s+disco=ssd$"]}, {"t": "K8-6.3", "m": "k8s", "p": "Lista los eventos del namespace actual ordenados por fecha de creación.", "s": "kubectl get events --sort-by=.metadata.creationTimestamp", "r": ["^kubectl\\s+get\\s+(events|event|ev)\\b", "--sort-by[\\s=]['\"]?\\.metadata\\.creationtimestamp['\"]?$"]}, {"t": "K8-6.3", "m": "k8s", "p": "Lista los pods que no están en fase Running usando un field-selector.", "s": "kubectl get pods --field-selector=status.phase!=Running", "r": ["^kubectl\\s+get\\s+(pods|pod|po)\\b", "--field-selector[\\s=]status\\.phase!=running\\b"]}, {"t": "K8-6.3", "m": "k8s", "p": "Lanza un contenedor de depuración efímero con busybox dentro del pod web.", "s": "kubectl debug -it web --image=busybox", "r": ["^kubectl\\s+debug\\b", "\\b(pod/)?web\\b", "--image[\\s=]busybox\\b"]}, {"t": "K8-6.3", "m": "k8s", "p": "Haz una copia de seguridad de etcd en /backup/etcd.db con etcdctl (añade los certificados en el examen real).", "s": "ETCDCTL_API=3 etcdctl snapshot save /backup/etcd.db", "r": ["etcdctl\\b", "snapshot\\s+save\\s+/backup/etcd\\.db\\b"]}, {"t": "K8-6.3", "m": "k8s", "p": "Muestra con kubeadm el plan de actualización del clúster (versiones disponibles).", "s": "kubeadm upgrade plan", "r": ["^(sudo\\s+)?kubeadm\\s+upgrade\\s+plan$"]}, {"t": "K8-6.3", "m": "k8s", "p": "Aplica con kubeadm la actualización del plano de control a la versión v1.37.1.", "s": "kubeadm upgrade apply v1.37.1", "r": ["^(sudo\\s+)?kubeadm\\s+upgrade\\s+apply\\s+v1\\.37\\.1$"]}, {"t": "K8-6.3", "m": "k8s", "p": "Añade a Helm el repositorio prometheus-community (https://prometheus-community.github.io/helm-charts).", "s": "helm repo add prometheus-community https://prometheus-community.github.io/helm-charts", "r": ["^helm\\s+repo\\s+add\\s+prometheus-community\\s+https://prometheus-community\\.github\\.io/helm-charts/?$"]}, {"t": "K8-6.3", "m": "k8s", "p": "Instala el chart prometheus-community/prometheus con el nombre de release monitor en el namespace monitoring, creándolo si no existe.", "s": "helm install monitor prometheus-community/prometheus -n monitoring --create-namespace", "r": ["^helm\\s+install\\s+monitor\\s+prometheus-community/prometheus\\b", "(-n|--namespace)[\\s=]monitoring\\b", "--create-namespace\\b"]}, {"t": "K8-6.3", "m": "k8s", "p": "Lista las releases de Helm de todos los namespaces.", "s": "helm list -A", "r": ["^helm\\s+(list|ls)\\b", "(?c)(-A\\b|--all-namespaces)"]}, {"t": "K8-6.3", "m": "k8s", "p": "Vuelve la release monitor de Helm a la revisión 1.", "s": "helm rollback monitor 1", "r": ["^helm\\s+rollback\\s+monitor\\s+1\\b"]}, {"t": "K8-6.3", "m": "k8s", "p": "Muestra los contenedores que ve el kubelet en un nodo, usando la herramienta CRI (crictl).", "s": "crictl ps", "r": ["^(sudo\\s+)?crictl\\s+ps\\b"]}]</script>
<script>
(function(){
"use strict";
/* ================= data ================= */
const MD = document.getElementById('md-src').textContent;
const QS = JSON.parse(document.getElementById('q-src').textContent);
const EX = JSON.parse(document.getElementById('ex-src').textContent);
const COURSES = {DK:'Docker', K8:'Kubernetes'};
const KEY = 'tai-docker-k8s-v1';

/* ================= storage ================= */
let S = {read:{}, q:{}, star:{}, ex:{}, last:null, theme:null};
function load(){ try{ const r = localStorage.getItem(KEY); if(r){ S = Object.assign(S, JSON.parse(r)); } }catch(e){} }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){} }
load();

/* ================= theme ================= */
function applyTheme(){ if(S.theme) document.documentElement.setAttribute('data-theme', S.theme); else document.documentElement.removeAttribute('data-theme'); }
applyTheme();
document.getElementById('themeBtn').onclick = () => {
  const dark = S.theme === 'dark';
  S.theme = dark ? 'light' : 'dark'; save(); applyTheme();
};

/* ================= markdown ================= */
function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function inline(s){
  const codes = [];
  s = s.replace(/`([^`]+)`/g, (m,c) => { codes.push(c); return '\u0000' + (codes.length-1) + '\u0000'; });
  s = esc(s);
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/(^|[\s(])\*([^*\s][^*]*?)\*(?=[\s.,;:)]|$)/g, '$1<em>$2</em>');
  s = s.replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  s = s.replace(/\u0000(\d+)\u0000/g, (m,i) => '<code>' + esc(codes[+i]) + '</code>');
  return s;
}
function highlight(code){
  return code.split('\n').map(l => {
    if (/^\s*(#|::|!|REM\s)/.test(l) && !/^\s*#\{/.test(l)) return '<span class="cm">' + esc(l) + '</span>';
    const k = l.search(/\s(#|::|!)\s/);
    if (k >= 0) return esc(l.slice(0, k)) + '<span class="cm">' + esc(l.slice(k)) + '</span>';
    return esc(l);
  }).join('\n');
}
function splitCells(r){
  r = r.trim().replace(/^\|/, '').replace(/\|$/, '');
  const out = []; let cur = '', inCode = false;
  for (const ch of r){
    if (ch === '`') inCode = !inCode;
    if (ch === '|' && !inCode){ out.push(cur.trim()); cur = ''; } else cur += ch;
  }
  out.push(cur.trim()); return out;
}
function mdToHtml(src){
  const lines = src.split('\n'); let html = ''; let i = 0;
  while (i < lines.length){
    let l = lines[i];
    let bx = l.match(/^:::(\w+)\s*$/);
    if (bx){
      let inner = []; i++;
      while (i < lines.length && !/^:::\s*$/.test(lines[i])) { inner.push(lines[i]); i++; }
      i++;
      html += '<div class="box box-' + bx[1] + '">' + mdToHtml(inner.join('\n')) + '</div>'; continue;
    }
    if (/^```/.test(l)){
      let code = []; i++;
      while (i < lines.length && !/^```/.test(lines[i])) { code.push(lines[i]); i++; }
      i++;
      html += '<pre><button class="copy">Copiar</button><code>' + highlight(code.join('\n')) + '</code></pre>'; continue;
    }
    if (/^---\s*$/.test(l)){ html += '<hr>'; i++; continue; }
    let h = l.match(/^(#{1,4})\s+(.*)$/);
    if (h){ const n = Math.min(h[1].length+0,4); html += '<h'+n+'>'+inline(h[2])+'</h'+n+'>'; i++; continue; }
    if (/^\|/.test(l)){
      let rows = [];
      while (i < lines.length && /^\|/.test(lines[i])) { rows.push(lines[i]); i++; }
      const cells = splitCells;
      let t = '<div class="tbl"><table><thead><tr>' + cells(rows[0]).map(c => '<th>'+inline(c)+'</th>').join('') + '</tr></thead><tbody>';
      rows.slice(2).forEach(r => { t += '<tr>' + cells(r).map(c => '<td>'+inline(c)+'</td>').join('') + '</tr>'; });
      html += t + '</tbody></table></div>'; continue;
    }
    if (/^>/.test(l)){
      let q = [];
      while (i < lines.length && /^>/.test(lines[i])) { q.push(lines[i].replace(/^>\s?/,'')); i++; }
      const txt = q.join('\n'); let cls = '';
      if (txt.includes('⚠️')) cls = 'trap'; else if (txt.includes('💡')) cls = 'key'; else if (txt.includes('🏛️')) cls = 'age';
      html += '<blockquote class="'+cls+'">' + q.filter(x=>x.trim()).map(x => '<p>'+inline(x)+'</p>').join('') + '</blockquote>'; continue;
    }
    if (/^\s*([-*]|\d+\.)\s+/.test(l)){
      const ordered = /^\s*\d+\./.test(l); let items = [];
      while (i < lines.length && /^\s*([-*]|\d+\.)\s+/.test(lines[i])) {
        let it = lines[i].replace(/^\s*([-*]|\d+\.)\s+/,''); const indent = /^\s{2,}/.test(lines[i]); i++;
        while (i < lines.length && /^\s{2,}\S/.test(lines[i]) && !/^\s*([-*]|\d+\.)\s+/.test(lines[i]) && !/^\s*```/.test(lines[i])) { it += ' ' + lines[i].trim(); i++; }
        let extra = '';
        if (i < lines.length && /^\s+```/.test(lines[i])) {
          let code = []; i++;
          while (i < lines.length && !/^\s*```/.test(lines[i])) { code.push(lines[i].replace(/^\s{2}/,'')); i++; }
          i++; extra = '<pre><button class="copy">Copiar</button><code>' + highlight(code.join('\n')) + '</code></pre>';
        }
        items.push({t:it, sub:indent, extra});
      }
      const tag = ordered ? 'ol' : 'ul';
      html += '<'+tag+'>' + items.map(x => '<li'+(x.sub?' style="margin-left:18px"':'')+'>'+inline(x.t)+x.extra+'</li>').join('') + '</'+tag+'>'; continue;
    }
    if (!l.trim()){ i++; continue; }
    let p = [l]; i++;
    while (i < lines.length && lines[i].trim() && !/^(#|```|\||>|---|\s*([-*]|\d+\.)\s)/.test(lines[i])) { p.push(lines[i]); i++; }
    html += '<p>' + inline(p.join(' ')) + '</p>';
  }
  return html;
}

