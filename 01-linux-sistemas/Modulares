function filterQs(c, lv, tp, mode){
  return QS.filter(q => {
    if (c !== 'all' && !q.t.startsWith(c + '-')) return false;
    if (lv !== 'all' && levelOf(q.t) !== lv) return false;
    if (tp !== 'all' && q.t !== tp) return false;
