const intro = []; const topics = []; const tree = [];
(function parse(){
  const lines = MD.split('\n'); let course = null, level = null, topic = null, inCode = false;
  for (const l of lines){
    if (/^```/.test(l)) inCode = !inCode;
    if (!inCode){
      let m;
      if ((m = l.match(/^# (.+)$/)) && !/^# Curso TAI/.test(l)){
        const name = m[1].trim(); const code = Object.keys(COURSES).find(k => COURSES[k] === name) || name;
        course = {code, name, levels:[]}; tree.push(course); level = null; topic = null; continue;
      }
      if ((m = l.match(/^## (.+)$/)) && course){ level = {name:m[1].trim(), topics:[]}; course.levels.push(level); topic = null; continue; }
      if ((m = l.match(/^### ((DK|K8)-\d+\.\d+) · (.+)$/))){
        topic = {id:m[1], title:m[3].trim(), course:course.code, level:level.name, md:''}; topics.push(topic); level.topics.push(topic); continue;
      }
    }
    if (topic) topic.md += l + '\n'; else if (!course) intro.push(l);
  }
  topics.forEach(t => { t.md = t.md.replace(/\n---\s*\n*$/, '\n'); });
})();
